<clickhouse>
    <!-- The s3() table function picks its credentials up from the endpoint prefix,
         so no ingestion query has to carry a key. -->
    <s3>
        <lake>
            <endpoint>http://minio:10000/lake/</endpoint>
            <access_key_id from_env="MINIO_ROOT_USER"/>
            <secret_access_key from_env="MINIO_ROOT_PASSWORD"/>
        </lake>
    </s3>
</clickhouse>
